{
  "manifest_version": 3,
  "name": "AutoClick SatuSehat - SIMPUS Validator",
  "version": "1.0.0",
  "description": "Otomatisasi klik validasi data pasien di SIMPUS Badung Sehat / SatuSehat. Auto klik mata -> Validasi -> Yakin, lalu lanjut pasien berikutnya.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoClick SatuSehat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
